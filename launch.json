            ]
        },
        {
            "name": "Odysseus Backend",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odysseus/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/odysseus"
        }
    ]
}
